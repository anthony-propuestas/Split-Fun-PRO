# Environment variables required for this project
# Copy this file to .env (for frontend) and .dev.vars (for worker) and fill in the values
# Neither .env nor .dev.vars should ever be committed to git

# Google OAuth 2.0 Client ID (get from Google Cloud Console)
# Used by the frontend for Google One Tap and by the worker to verify credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
